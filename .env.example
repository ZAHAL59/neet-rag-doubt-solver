# Copy to .env and fill in ONE key. Without any key the app still runs offline
# (TF-IDF retrieval + extractive answers), which is handy for development.

GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional overrides
# EMBEDDER=gemini            # gemini | local
# LLM_PROVIDER=gemini        # gemini | anthropic | none
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_MODEL=claude-haiku-5-5
# TOP_K=4
# MIN_SCORE=0.55             # similarity below which a question is refused

# Admin uploads (/admin). Leave empty to disable uploads.
# ADMIN_TOKEN=choose-a-long-password
# Keep uploads permanently by committing them to the repo (recommended on free hosting)
# GITHUB_TOKEN=
# GITHUB_REPO=ZAHAL59/neet-rag-doubt-solver
